		cam_vana-supply = <&L4M>;
		cam_vio-supply = <&L5M>;
		cam_vdig-supply = <&L2M>;
		cam_v_custom1-supply = <&regulator_1v2>;
		regulator-names = "cam_vana", "cam_vio", "cam_vdig", "cam_v_custom1";
		rgltr-cntrl-support;
		rgltr-min-voltage = <2800000 1800000 1104000 1200000>;
		rgltr-max-voltage = <2800000 1800000 1104000 1200000>;
		rgltr-load-current = <61000 1000 177000 2000>;
		aon-camera-id = <1>;
		status = "ok";
	};

	eeprom_uw: qcom,eeprom2 {
