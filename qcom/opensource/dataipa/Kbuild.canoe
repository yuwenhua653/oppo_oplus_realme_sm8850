ccflags-y += -I$(src)/drivers/platform/msm/ipa/ipa_clients
ccflags-y += -I$(src)/config
ccflags-y += -I$(src)/../datarmnet-ext/mem
ccflags-y += -I$(src)/../datarmnet-ext/mem/include/uapi/linux
KBUILD_EXTRA_SYMBOLS += $(abspath $(obj)/../datarmnet-ext/mem/Module.symvers)

obj-m += gsim.o
gsim-y := drivers/platform/msm/gsi/gsi.o \
	drivers/platform/msm/gsi/gsi_dbg.o \
	drivers/platform/msm/gsi/gsihal/gsihal.o \
	drivers/platform/msm/gsi/gsihal/gsihal_reg.o
