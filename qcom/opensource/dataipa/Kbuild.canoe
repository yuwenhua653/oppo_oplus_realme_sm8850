# Canoe source/configuration selection from the pinned DDK declarations.
ccflags-y += -I$(src) -I$(srctree)
ccflags-y += -I$(src)/drivers/platform/msm/include
ccflags-y += -I$(src)/drivers/platform/msm/include/linux
ccflags-y += -I$(src)/drivers/platform/msm/include/uapi
ccflags-y += -I$(src)/drivers/platform/msm/gsi
ccflags-y += -I$(src)/drivers/platform/msm/gsi/gsihal
