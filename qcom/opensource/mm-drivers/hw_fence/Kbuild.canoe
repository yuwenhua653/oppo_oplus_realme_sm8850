# SPDX-License-Identifier: GPL-2.0-only
# Canoe source selection from define_hw_fence.bzl.
ccflags-y += -I$(srctree)
ccflags-y += -I$(src)/../hfi_core/inc -I$(src)/../hw_fence/include
ccflags-y += -I$(src)/../msm_ext_display/include -I$(src)/../sync_fence/include
ccflags-y += -I$(src)/../sync_fence/include/uapi -I$(src)/../config
ccflags-y += -I$(src)/../../synx-kernel/msm/synx
ccflags-y += -I$(src)/../../synx-kernel/include/uapi/synx
ccflags-y += -I$(src)/../../synx-kernel/include/uapi/synx/media
ccflags-y += -DCONFIG_QTI_HW_FENCE=1
ccflags-y += -DCONFIG_QTI_HW_FENCE_USE_SYNX=1
ccflags-y += -DCONFIG_QTI_ENABLE_HW_FENCE_DEFAULT=1

obj-m += msm_hw_fence.o
msm_hw_fence-y := src/hw_fence_drv_debug.o \
	src/hw_fence_drv_ipc.o \
	src/hw_fence_drv_priv.o \
	src/hw_fence_drv_utils.o \
	src/msm_hw_fence.o
ifneq ($(filter y m,$(CONFIG_DEBUG_FS)),)
msm_hw_fence-y += src/hw_fence_ioctl.o
endif
msm_hw_fence-y += src/msm_hw_fence_synx_translation.o src/hw_fence_drv_interop.o
ifneq ($(filter y m,$(CONFIG_MSM_HAB)),)
msm_hw_fence-y += src/hw_fence_drv_virtio.o
endif
