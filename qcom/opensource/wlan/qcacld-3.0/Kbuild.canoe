quiet_cmd_canoe_features = GEN     $@
      cmd_canoe_features = { printf '%s\n' '/* Kernel feature probes for Canoe WLAN. */'; \
	if grep -qF 'nl80211_validate_key_link_id' $(srctree)/net/wireless/nl80211.c; then printf '%s\n' '\#define CFG80211_MLO_KEY_OPERATION_SUPPORT (1)'; fi; \
	if grep -qF 'struct link_station_parameters' $(srctree)/include/net/cfg80211.h; then printf '%s\n' '\#define CFG80211_LINK_STA_PARAMS_PRESENT (1)'; fi; \
	if grep -qF 'NL80211_EXT_FEATURE_PUNCT' $(srctree)/include/uapi/linux/nl80211.h; then printf '%s\n' '\#define NL80211_EXT_FEATURE_PUNCT_SUPPORT (1)'; fi; \
	if grep -qF 'unsigned int link_id, u16 punct_bitmap' $(srctree)/include/net/cfg80211.h; then printf '%s\n' '\#define CFG80211_RU_PUNCT_NOTIFY (1)'; fi; \
	if grep -qF 'NL80211_EXT_FEATURE_AUTH_AND_DEAUTH_RANDOM_TA' $(srctree)/include/uapi/linux/nl80211.h; then printf '%s\n' '\#define CFG80211_EXT_FEATURE_AUTH_AND_DEAUTH_RANDOM_TA (1)'; fi; \
	if grep -qF 'NL80211_CMD_SET_TID_TO_LINK_MAPPING' $(srctree)/include/uapi/linux/nl80211.h; then printf '%s\n' '\#define WLAN_FEATURE_11BE_MLO_TTLM (1)'; fi; \
	if grep -qF 'IEEE80211_CHANCTX_CHANGE_PUNCTURING' $(srctree)/include/net/mac80211.h; then printf '%s\n' '\#define CFG80211_RU_PUNC_CHANDEF (1)'; fi; \
	if grep -qF 'Indicates whether the add links request is initiated by' $(srctree)/include/net/cfg80211.h; then printf '%s\n' '\#define CFG80211_SETUP_LINK_RECONFIG_SUPPORT (1)'; fi; \
	} > $@
targets += canoe_features.h
$(obj)/canoe_features.h: $(srctree)/net/wireless/nl80211.c $(srctree)/include/net/cfg80211.h $(srctree)/include/uapi/linux/nl80211.h $(srctree)/include/net/mac80211.h FORCE
	$(call if_changed,canoe_features)
$(addprefix $(obj)/,$(qca_cld3_peach_v2-y)): $(obj)/canoe_features.h
