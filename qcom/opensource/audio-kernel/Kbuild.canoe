obj-m += wsa883x_dlkm.o
wsa883x_dlkm-y := asoc/codecs/wsa883x/wsa883x.o \
	asoc/codecs/wsa883x/wsa883x-regmap.o \
	asoc/codecs/wsa883x/wsa883x-tables.o

obj-m += wsa884x_dlkm.o
wsa884x_dlkm-y := asoc/codecs/wsa884x/wsa884x.o \
