	fingerprint/canoe-fingerprint.dtbo \
	graphics/gpu/canoe-gpu.dtbo \
	mm/hfi_core/canoe-hfi-core.dtbo \
	mm/hw_fence/canoe-hw-fence.dtbo \
	data/canoe-ipa.dtbo \
	mmrm/canoe/canoe-mmrm.dtbo \
	wlan/canoe-peach-cnss.dtbo \
	display/display/canoe-sde.dtbo \
	data/canoe-smem-mailbox.dtbo \
	synx/synx/canoe-synx.dtbo \
	canoe-tp-v2.dtb \
	canoe-tp.dtb \
	graphics/gpu/canoe-v2-gpu.dtbo \
	canoe-v2.dtb \
	video/canoe-vidc-v2.dtbo \
	video/canoe-vidc.dtbo \
	bt/canoe-wcn786x-bt.dtbo \
	canoe.dtb \
	canoep-tp-v2.dtb \
