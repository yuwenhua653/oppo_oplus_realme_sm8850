+static int strategy_fg_read_eu_policy(struct strategy_fg *fg)
+{
+	bool is_eu_model;
+	int ret = charger_partition_get_eu_model(&is_eu_model);
+
+	fg->eu_policy_errno = ret;
+	if (ret) {
+		dev_warn(fg->dev,
+			 "charger EU policy unavailable (%d); using gauge SOC without regional recharge policy\n",
+			 ret);
+		return ret;
+	}
+	fg->is_eu_model = is_eu_model;
+	fg->eu_policy_valid = true;
+	fg->boot_update_soc = is_eu_model;
 	return 0;
 }
 
