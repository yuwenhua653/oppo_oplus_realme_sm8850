+/* Select only DT-declared receiver states; never infer a GPIO number. */
+static int tfa98xx_set_spksw(struct tfa98xx *tfa98xx, int level)
+{
+	int ret;
+
+	if (level != 0 && level != 1)
+		return -EINVAL;
+	mutex_lock(&tfa98xx->dsp_lock);
+	if (tfa98xx->rcv_pinctrl)
+		ret = pinctrl_select_state(tfa98xx->rcv_pinctrl,
+			level ? tfa98xx->rcv_gpio_high : tfa98xx->rcv_gpio_low);
+	else if (gpio_is_valid(tfa98xx->spk_sw_gpio))
+		ret = gpio_direction_output(tfa98xx->spk_sw_gpio, level);
+	else
+		ret = -ENODEV;
+	if (!ret)
+		tfa98xx->spk_sw_level = level;
+	mutex_unlock(&tfa98xx->dsp_lock);
+	return ret;
+}
