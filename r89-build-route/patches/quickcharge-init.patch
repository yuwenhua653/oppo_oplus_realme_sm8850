+
+/* R89: a read-only snapshot exists even when the platform device cannot bind.
+ * Only the latest active probe updates it; runtime battery-table updates do not.
+ * dependency_errno is the returned dependency status, or a local -ENOENT /
+ * -ENOMEM for a missing object. It is distinct from the legacy probe return.
+ */
+struct mca_quick_charge_probe_diag {
+	unsigned int attempt;
+	bool active;
+	struct task_struct *owner;
+	struct mca_quick_charge_info *info;
+	const char *stage;
+	int probe_errno;
+	int dependency_errno;
+	bool dependency_recorded;
+	int country;
+	int global_table;
+	int mode;
+	char main_cell[32];
+	char table[64];
+};
+
+static DEFINE_MUTEX(mca_quick_charge_probe_diag_lock);
+static struct mca_quick_charge_probe_diag mca_quick_charge_diag = {
+	.stage = "not_started", .country = -1, .global_table = -1,
+	.mode = -1,
+};
+
+static void mca_quick_charge_diag_begin(void)
+{
+	unsigned int attempt;
+
+	mutex_lock(&mca_quick_charge_probe_diag_lock);
+	attempt = mca_quick_charge_diag.attempt + 1;
+	mca_quick_charge_diag = (struct mca_quick_charge_probe_diag) {
+		.attempt = attempt, .active = true, .owner = current, .stage = "fg_ready",
+		.probe_errno = -EINPROGRESS, .country = -1, .global_table = -1,
+		.mode = -1,
+	};
+	mutex_unlock(&mca_quick_charge_probe_diag_lock);
+}
+
+static void mca_quick_charge_diag_attach(struct mca_quick_charge_info *info)
+{
+	mutex_lock(&mca_quick_charge_probe_diag_lock);
+	if (mca_quick_charge_diag.active && mca_quick_charge_diag.owner == current) {
+		mca_quick_charge_diag.info = info;
+		mca_quick_charge_diag.stage = "parse_dt";
+	}
+	mutex_unlock(&mca_quick_charge_probe_diag_lock);
+}
+
+static void mca_quick_charge_diag_note(struct mca_quick_charge_info *info,
+				     const char *stage, int dependency_errno)
+{
+	mutex_lock(&mca_quick_charge_probe_diag_lock);
+	if (mca_quick_charge_diag.active && mca_quick_charge_diag.owner == current &&
+	    mca_quick_charge_diag.info == info) {
+		mca_quick_charge_diag.stage = stage;
+		mca_quick_charge_diag.dependency_errno = dependency_errno;
+		mca_quick_charge_diag.dependency_recorded = true;
+	}
+	mutex_unlock(&mca_quick_charge_probe_diag_lock);
+}
+
+static void mca_quick_charge_diag_context(struct mca_quick_charge_info *info,
+					int country, int global_table, int mode)
+{
+	mutex_lock(&mca_quick_charge_probe_diag_lock);
+	if (mca_quick_charge_diag.active && mca_quick_charge_diag.owner == current &&
+	    mca_quick_charge_diag.info == info) {
+		mca_quick_charge_diag.country = country;
+		mca_quick_charge_diag.global_table = global_table;
+		mca_quick_charge_diag.mode = mode;
+	}
+	mutex_unlock(&mca_quick_charge_probe_diag_lock);
+}
+
+static void mca_quick_charge_diag_cell(struct mca_quick_charge_info *info,
+				     const char *name)
+{
+	mutex_lock(&mca_quick_charge_probe_diag_lock);
+	if (mca_quick_charge_diag.active && mca_quick_charge_diag.owner == current &&
+	    mca_quick_charge_diag.info == info)
+		strscpy(mca_quick_charge_diag.main_cell, name ?: "<missing>",
+			sizeof(mca_quick_charge_diag.main_cell));
+	mutex_unlock(&mca_quick_charge_probe_diag_lock);
+}
+
+static void mca_quick_charge_diag_table(struct mca_quick_charge_info *info,
+				      const char *name)
+{
+	mutex_lock(&mca_quick_charge_probe_diag_lock);
+	if (mca_quick_charge_diag.active && mca_quick_charge_diag.owner == current &&
+	    mca_quick_charge_diag.info == info)
+		strscpy(mca_quick_charge_diag.table, name,
+			sizeof(mca_quick_charge_diag.table));
+	mutex_unlock(&mca_quick_charge_probe_diag_lock);
+}
+
+static int mca_quick_charge_diag_finish(const char *stage, int result,
+				      int dependency_errno)
+{
+	mutex_lock(&mca_quick_charge_probe_diag_lock);
+	if (mca_quick_charge_diag.active && mca_quick_charge_diag.owner == current) {
+		if (stage)
+			mca_quick_charge_diag.stage = stage;
+		if (stage || !mca_quick_charge_diag.dependency_recorded)
+			mca_quick_charge_diag.dependency_errno = dependency_errno;
+		mca_quick_charge_diag.probe_errno = result;
+		mca_quick_charge_diag.active = false;
+		mca_quick_charge_diag.owner = NULL;
+		mca_quick_charge_diag.info = NULL;
+	}
+	mutex_unlock(&mca_quick_charge_probe_diag_lock);
+	return result;
+}
+
+static int mca_quick_charge_probe_status_get(char *buf,
+					   const struct kernel_param *kp)
+{
+	const struct mca_quick_charge_probe_diag *d = &mca_quick_charge_diag;
+	int ret;
+
+	(void)kp;
+	mutex_lock(&mca_quick_charge_probe_diag_lock);
+	ret = scnprintf(buf, PAGE_SIZE,
+		"attempt=%u active=%d stage=%s probe_errno=%d dependency_errno=%d "
+		"country=%d global_table=%d mode=%d cell=%s table=%s\n",
+		d->attempt, d->active, d->stage, d->probe_errno, d->dependency_errno,
+		d->country, d->global_table, d->mode,
+		d->main_cell[0] ? d->main_cell : "<unread>",
+		d->table[0] ? d->table : "<unselected>");
+	mutex_unlock(&mca_quick_charge_probe_diag_lock);
+	return ret;
+}
+
+static const struct kernel_param_ops mca_quick_charge_probe_status_ops = {
+	.get = mca_quick_charge_probe_status_get,
+};
+module_param_cb(probe_status, &mca_quick_charge_probe_status_ops, NULL, 0444);
+MODULE_PARM_DESC(probe_status, "Read-only latest quick-charge probe diagnostic snapshot");
+
 
