+/* All IRQs are released before work or callback backing storage can disappear. */
+static void adc5_gen3_free_irqs(struct adc5_chip *adc)
+{
+	int i;
+
+	for (i = 0; i < adc->num_sdams; i++) {
+		if (!adc->base[i].irq_requested)
+			continue;
+		devm_free_irq(adc->dev, adc->base[i].irq, adc);
+		adc->base[i].irq_requested = false;
+	}
+}
+
+static int adc5_gen3_request_irqs(struct adc5_chip *adc)
+{
+	int i, ret;
+
+	for (i = 0; i < adc->num_sdams; i++) {
+		ret = devm_request_irq(adc->dev, adc->base[i].irq, adc5_gen3_isr,
+				0, adc->base[i].irq_name, adc);
+		if (ret) {
+			adc5_gen3_free_irqs(adc);
+			return ret;
+		}
+		adc->base[i].irq_requested = true;
+	}
+	return 0;
+}
+
+static void adc5_gen3_publish_ready(struct adc5_chip *adc)
+{
+	unsigned long flags;
+	int i;
+
+	mutex_lock(&adc->lock);
+	adc->state = ADC5_GEN3_READY;
+	spin_lock_irqsave(&adc->tm_lock, flags);
+	adc->tm_ready = true;
+	/* Consume status/faults that arrived while thermal zones were unpublished. */
+	if (adc->n_tm_channels) {
+		schedule_work(&adc->tm_handler_work);
+		schedule_work(&adc->tm_err_handler_work);
+	}
+	spin_unlock_irqrestore(&adc->tm_lock, flags);
+	for (i = 0; i < adc->nchannels; i++) {
+		struct adc5_channel_prop *prop = &adc->chan_props[i];
+
+		if (prop->req_wq && (prop->low_thr_triggered || prop->high_thr_triggered))
+			queue_work(prop->req_wq, &prop->work);
+	}
+	mutex_unlock(&adc->lock);
+}
+
+static void adc5_gen3_quiesce(struct adc5_chip *adc, bool permanent)
+{
+	unsigned long flags;
+	int i;
+
+	/* The gate and every ISR queue operation share this lock. */
+	spin_lock_irqsave(&adc->tm_lock, flags);
+	adc->tm_ready = false;
+	spin_unlock_irqrestore(&adc->tm_lock, flags);
+
+	/* Keep completion IRQs and transactions alive while old TM callbacks drain.
+	 * In particular, thermal updates can synchronously call get_temp/set_trips.
+	 */
+	cancel_work_sync(&adc->tm_err_handler_work);
+	cancel_work_sync(&adc->tm_handler_work);
+	mutex_lock(&adc->lock);
+	adc->state = permanent ? ADC5_GEN3_STOPPING : ADC5_GEN3_SUSPENDED;
+	mutex_unlock(&adc->lock);
+	adc5_gen3_free_irqs(adc);
+
+	if (!adc->chan_props)
+		return;
+	for (i = 0; i < adc->nchannels; i++) {
+		if (adc->chan_props[i].req_wq)
+			cancel_work_sync(&adc->chan_props[i].work);
+	}
+}
+
+static void adc5_gen3_destroy_queues(struct adc5_chip *adc)
+{
+	int i;
+
+	if (!adc->chan_props)
+		return;
+	for (i = 0; i < adc->nchannels; i++) {
+		if (!adc->chan_props[i].req_wq)
+			continue;
+		destroy_workqueue(adc->chan_props[i].req_wq);
+		adc->chan_props[i].req_wq = NULL;
+	}
+}
+
+static void adc5_gen3_disable_channels(struct adc5_chip *adc)
+{
+	u8 data;
+	int i, sdam_index;
+
+	if (!adc->hw_started)
+		return;
+	mutex_lock(&adc->lock);
+	for (i = 0; i < adc->nchannels; i++)
+		adc->chan_props[i].timer = MEAS_INT_DISABLE;
+	/* Preserve normal monitoring teardown for every owned SDAM slot. */
+	for (i = 0; i < adc->num_sdams * 8; i++) {
+		sdam_index = i / 8;
+		data = MEAS_INT_DISABLE;
+		adc5_write(adc, sdam_index, ADC5_GEN3_TIMER_SEL, &data, 1);
+		data = ADC5_GEN3_CHAN_CONV_REQ | (i - (sdam_index * 8));
+		adc5_write(adc, sdam_index, ADC5_GEN3_PERPH_CH, &data, 1);
+		data = ADC5_GEN3_CONV_REQ_REQ;
+		adc5_write(adc, sdam_index, ADC5_GEN3_CONV_REQ, &data, 1);
+	}
+	adc->hw_started = false;
+	mutex_unlock(&adc->lock);
+}
+
+static void adc5_gen3_unpublish(struct adc5_chip *adc)
+{
+	mutex_lock(&adc_tm_device_list_lock);
+	if (adc->device_list) {
+		list_del_init(&adc->list);
+		adc->device_list = NULL;
+	}
+	mutex_unlock(&adc_tm_device_list_lock);
+}
+
+static void adc5_gen3_cleanup(struct adc5_chip *adc)
+{
+	adc5_gen3_unpublish(adc);
+	adc5_gen3_quiesce(adc, true);
+	adc5_gen3_destroy_queues(adc);
+	adc5_gen3_disable_channels(adc);
+	if (adc->ipc_log) {
+		ipc_log_context_destroy(adc->ipc_log);
+		adc->ipc_log = NULL;
+	}
+	/* The private mutex must outlive devm thermal/IIO callback unregister. */
+}
